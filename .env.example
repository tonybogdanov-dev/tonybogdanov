# Contact email the /api/email and /api/contact routes use. Kept out of the client bundle and
# out of version control. Required — the build and the server refuse to run without it.
CONTACT_EMAIL=you@example.com

# Resend API key — https://resend.com/api-keys. Used by /api/contact to deliver submissions.
RESEND_API_KEY=

# Cloudflare Turnstile secret key — Turnstile tab of the Cloudflare dashboard. Used by
# /api/contact to verify the captcha token. The matching public site key lives in
# config/turnstile.yaml (not a secret, safe to commit).
TURNSTILE_SECRET_KEY=

# BrowserStack credentials — https://www.browserstack.com/accounts/settings. Only needed for
# `scripts/screenshot.ts`.
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# URL BrowserStack should load (served via BrowserStack Local tunnel).
# Defaults to the Vite dev server if unset.
SCREENSHOT_URL=http://localhost:5173

# Set only when Playwright's bundled Chromium can't run (e.g. musl/Alpine); points at a system
# Chromium binary instead. Leave unset where the bundled browser works.
PLAYWRIGHT_CHROMIUM_PATH=
